# 逗号分隔，目前识别 webfetch、websearch；设为空字符串等效于全部关闭（纯透传）
# websearch 接的是真正工作的 agentic 搜索后端（Kimi K3 规划/反思 + SearXNG 并发检索 +
# DeepSeek Flash 富化/汇总，见下面的 --- WebSearch 分支 --- 一节），不是占位实现。默认不在
# ENABLE_TARGETS 里，需要显式加上；启用后默认会自管理一个本地 SearXNG Docker 容器，需要本机
# 有 Docker。见 doc/design/2026-09-02_websearch-agentic-search_v1.md。
WEBFETCH_MITM_ENABLE_TARGETS=webfetch

# openrouter 或 zai，二选一，决定这次转发实际生效的后端
WEBFETCH_MITM_PROVIDER=openrouter

# --- OpenRouter 分支 ---
WEBFETCH_MITM_OPENROUTER_API_KEY=
# 逗号分隔的模型 ID 列表，按顺序在 OpenRouter 服务端内部做 fallback
WEBFETCH_MITM_OPENROUTER_MODELS=deepseek/deepseek-v4-flash-0731
# 可选：逗号分隔的底层算力商偏好列表（provider.order）
WEBFETCH_MITM_OPENROUTER_PROVIDERS=
# 算力商路由排序（provider.sort）。未设置时默认 throughput——WebFetch 卡在 CC 主循环上，
# 优先选吞吐高的端点；OpenRouter 默认是按价格升序，会落到最便宜也最慢的端点。
# 可选值：throughput / latency / price；设为空字符串则回退到 OpenRouter 默认。
# 不要配 allow_fallbacks:false 钉死单一端点——官方端点会偶发 404，留 fallback 更稳。
WEBFETCH_MITM_OPENROUTER_SORT=throughput

# --- ZAI 分支（直连 https://api.z.ai/api/anthropic）---
WEBFETCH_MITM_ZAI_API_KEY=
# 逗号分隔的模型 ID 列表，provider 自己顺序遍历重试
WEBFETCH_MITM_ZAI_MODELS=glm-4.7-flashx,glm-4.7-flash,glm-4.5-flash

# --- WebSearch 分支（默认按 latency 排序；没有"最大轮数"/"超时时长"这类业务上限配置项，
# 由规划阶段的 Kimi K3 每次自行决定，见设计文档第 1、3、13 节）---
# 检索后端，当前只实现 searxng
WEBFETCH_MITM_WEBSEARCH_BACKEND=searxng
# 外部已有 SearXNG 实例的根地址。留空是默认、推荐用法——本项目自己在本机管理一个 SearXNG
# Docker 容器（固定名 webfetch-mitm-searxng、固定端口 18888），不需要预先部署；只有明确要接
# 一个已经在跑（或跨项目共享）的实例时才填这个变量。
WEBFETCH_MITM_WEBSEARCH_SEARXNG_URL=
# SearXNG categories 参数
WEBFETCH_MITM_WEBSEARCH_SEARXNG_CATEGORIES=general
# 规划、反思用的推理模型（OpenRouter）。为空时 websearch 直接 fail-open（等价于关闭）。
WEBFETCH_MITM_WEBSEARCH_REASON_API_KEY=
WEBFETCH_MITM_WEBSEARCH_REASON_BASE_URL=https://openrouter.ai/api/v1
WEBFETCH_MITM_WEBSEARCH_REASON_MODEL=moonshotai/kimi-k3
# reasoning_effort 取值，仅在目标模型已知支持时才会发送（当前只有 kimi-k3 系列）
WEBFETCH_MITM_WEBSEARCH_REASON_EFFORT=low
WEBFETCH_MITM_WEBSEARCH_REASON_SORT=latency
# 富化提炼、最终汇总共用的模型（DeepSeek Flash）。API key 留空则回退用 REASON_API_KEY。
WEBFETCH_MITM_WEBSEARCH_SUMMARY_API_KEY=
WEBFETCH_MITM_WEBSEARCH_SUMMARY_BASE_URL=https://openrouter.ai/api/v1
WEBFETCH_MITM_WEBSEARCH_SUMMARY_MODEL=deepseek/deepseek-v4-flash-0731
WEBFETCH_MITM_WEBSEARCH_SUMMARY_SORT=latency
# 返回给主循环的 sources 列表最大条目数——这是响应体裁剪参数，不是搜索深度参数
WEBFETCH_MITM_WEBSEARCH_MAX_SOURCES=20

# --- 通用 ---
# 摘要指令模板文件的绝对路径；未设置时使用项目内置默认模板 templates/webfetch-summary.txt
WEBFETCH_MITM_PROMPT_FILE=
